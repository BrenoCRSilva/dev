{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "omarchy.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "pontual.tray"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMM yyyy"
        },
        {
          "id": "foamy.notification-center"
        },
        {
          "id": "io.github.aashbury.voxhud"
        },
        {
          "id": "io.github.jcarcinogen.gaming-console"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "pontual.workspaces"
        },
        {
          "id": "sys-monitor",
          "showNet": false
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "io.github.akafrmn.galaxy-buds-pro"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "crmne.hyprmoncfg"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "foamy.notification-center"
    },
    {
      "id": "io.github.maajix.spotlight"
    }
  ],
  "version": 1
}
