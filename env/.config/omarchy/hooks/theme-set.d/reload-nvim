#!/usr/bin/env bash
set -euo pipefail

# Omarchy has finished staging current/theme before invoking theme-set hooks.
# Signal only existing servers; never start an editor or depend on a daemon.
command -v nvim >/dev/null || exit 0
uid="$(id -u)"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$uid}"
nvim_exe="$(readlink -f "$(command -v nvim)")"
if [[ -d "$runtime_dir" ]]; then
	while IFS= read -r -d '' socket; do
		[[ -S "$socket" ]] || continue
		[[ "$(stat -c %u "$socket" 2>/dev/null || true)" == "$uid" ]] || continue
		if pid="$(timeout 2 nvim --server "$socket" --remote-expr 'getpid()' 2>/dev/null)"; then
			:
		else
			status=$?
			if (( status == 124 || status == 137 )); then
				printf 'theme-set: Neovim server timed out during PID probe; skipping %s\n' "$socket" >&2
			fi
			continue
		fi
		[[ "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]] || continue
		[[ "$(stat -c %u "/proc/$pid" 2>/dev/null || true)" == "$uid" ]] || continue
		[[ "$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)" == "$nvim_exe" ]] || continue
		if timeout 2 nvim --server "$socket" --remote-send '<Cmd>lua if vim.loader and vim.loader.reset then vim.loader.reset() end; pcall(function() require("lazy.core.cache").reset() end); package.loaded["omarchy-theme"] = nil; package.loaded["omarchy-colors"] = nil; pcall(function() require("omarchy-theme").reload() end)<CR>' >/dev/null 2>&1; then
			:
		else
			status=$?
			if (( status == 124 || status == 137 )); then
				printf 'theme-set: Neovim server timed out during reload; skipping %s\n' "$socket" >&2
			else
				printf 'theme-set: Neovim reload failed for %s\n' "$socket" >&2
			fi
		fi
	done < <(find "$runtime_dir" -maxdepth 4 -type s -uid "$uid" -name 'nvim.*' -print0 2>/dev/null)
fi
