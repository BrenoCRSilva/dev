{
  "statusLine": {
    "type": "command",
    "command": "~/.config/tmux/scripts/task-statusline.sh"
  },
  "disableClaudeAiConnectors": true,
  "env": {
    "CLAUDE_CODE_RESUME_THRESHOLD_MINUTES": "999999",
    "CLAUDE_CODE_RESUME_TOKEN_THRESHOLD": "999999999"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmux/scripts/task-context-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmux/scripts/task-context-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmux/scripts/task-compact-context.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/tmux/scripts/task-agent.sh session-hook orchestrator",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
