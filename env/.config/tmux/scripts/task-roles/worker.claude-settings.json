{
  "permissions": {
    "deny": [
      "Read(~/.config/task-agents/**)",
      "Read(//home/pontual/.config/task-agents/**)",
      "Edit(~/.config/task-agents/**)",
      "Edit(//home/pontual/.config/task-agents/**)",
      "Write(~/.config/task-agents/**)",
      "Write(//home/pontual/.config/task-agents/**)"
    ]
  },
  "env": {
    "CODEGRAPH_TELEMETRY": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/tmux/scripts/task-guard.sh worker",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/tmux/scripts/task-guard.sh worker",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/tmux/scripts/task-assignment.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
