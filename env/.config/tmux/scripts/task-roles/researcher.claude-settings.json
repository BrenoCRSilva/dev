{
  "env": {
    "CODEGRAPH_TELEMETRY": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/tmux/scripts/task-assignment.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/tmux/scripts/task-guard.sh researcher",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
